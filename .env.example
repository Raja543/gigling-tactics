# ── Database (Postgres: Neon or Supabase) ──
# App queries: use the POOLED connection (PgBouncer) for low latency + connection
# reuse (serverless-friendly). Neon: the `-pooler` host. Supabase: port 6543.
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require&pgbouncer=true"
# Migrations: the DIRECT (non-pooled) connection. Prisma uses this for migrate/introspect.
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require"

# ── Chain (Abstract) ──
NEXT_PUBLIC_ABSTRACT_RPC="https://api.mainnet.abs.xyz"
# GigaPetNFT contract — used to read on-chain Gigling ownership.
NEXT_PUBLIC_GIGA_PET_NFT_ADDRESS="0xd320831c876190c7ef79376ffcc889756f038e04"

# ── Gigaverse racing API ──
GIGAVERSE_API_BASE="https://gigaverse.io/api/racing"

# ── Admin ──
# Secret that gates the leaderboard sync endpoint (/api/cards/sync). Without it
# set, sync is disabled. Keep server-side only (NOT NEXT_PUBLIC).
ADMIN_SYNC_TOKEN=""
